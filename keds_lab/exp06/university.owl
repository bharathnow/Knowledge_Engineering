<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/university.owl"
         xmlns="http://example.org/university.owl#">

<owl:Ontology rdf:about="http://example.org/university.owl"/>

<owl:ObjectProperty rdf:about="#enrolledIn">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Course"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#teaches">
  <rdfs:domain rdf:resource="#Faculty"/>
  <rdfs:range rdf:resource="#Course"/>
  <owl:inverseOf rdf:resource="#taughtBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#belongsTo">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Department"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#taughtBy">
  <owl:inverseOf rdf:resource="#teaches"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasName">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCredits">
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Student">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <owl:disjointWith rdf:resource="#Faculty"/>
</owl:Class>

<owl:Class rdf:about="#Faculty">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#UGStudent">
  <rdfs:subClassOf rdf:resource="#Student"/>
</owl:Class>

<owl:Class rdf:about="#PGStudent">
  <rdfs:subClassOf rdf:resource="#Student"/>
</owl:Class>

<owl:Class rdf:about="#Professor">
  <rdfs:subClassOf rdf:resource="#Faculty"/>
</owl:Class>

<owl:Class rdf:about="#Course">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#taughtBy"/>
      <owl:onClass rdf:resource="#Faculty"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Department">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Programme">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#EnrolledPerson">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Person"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#enrolledIn"/>
          <owl:someValuesFrom rdf:resource="#Course"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Student"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#CSE">
  <rdf:type rdf:resource="#Department"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ECE">
  <rdf:type rdf:resource="#Department"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DataScience">
  <rdf:type rdf:resource="#Course"/>
  <hasCredits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasCredits>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KnowledgeRepresentation">
  <rdf:type rdf:resource="#Course"/>
  <hasCredits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasCredits>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MachineLearning">
  <rdf:type rdf:resource="#Course"/>
  <hasCredits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasCredits>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DigitalCircuits">
  <rdf:type rdf:resource="#Course"/>
  <hasCredits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasCredits>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DrRao">
  <rdf:type rdf:resource="#Professor"/>
  <belongsTo rdf:resource="#CSE"/>
  <teaches rdf:resource="#MachineLearning"/>
  <teaches rdf:resource="#KnowledgeRepresentation"/>
  <teaches rdf:resource="#DataScience"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dr. Rao</hasName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DrMeena">
  <rdf:type rdf:resource="#Professor"/>
  <belongsTo rdf:resource="#ECE"/>
  <teaches rdf:resource="#DigitalCircuits"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dr. Meena</hasName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Asha">
  <rdf:type rdf:resource="#UGStudent"/>
  <enrolledIn rdf:resource="#KnowledgeRepresentation"/>
  <enrolledIn rdf:resource="#DataScience"/>
  <belongsTo rdf:resource="#CSE"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asha</hasName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Ravi">
  <rdf:type rdf:resource="#UGStudent"/>
  <enrolledIn rdf:resource="#MachineLearning"/>
  <belongsTo rdf:resource="#CSE"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ravi</hasName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Divya">
  <rdf:type rdf:resource="#PGStudent"/>
  <enrolledIn rdf:resource="#MachineLearning"/>
  <enrolledIn rdf:resource="#DataScience"/>
  <belongsTo rdf:resource="#CSE"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Divya</hasName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Karthik">
  <rdf:type rdf:resource="#Person"/>
  <enrolledIn rdf:resource="#DigitalCircuits"/>
  <belongsTo rdf:resource="#ECE"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karthik</hasName>
</owl:NamedIndividual>


</rdf:RDF>
